{
  "algorithm": "DySymNet",

  "experiment": {
    "budget": {
      "max_evaluations": 1000
    },

    "cross_validation": {
      "n_folds": 5,
      "shuffle": true,
      "seeds": [
        42,
        43,
        44,
        45,
        46
      ]
    },

    "datasets": [
      "chemical_2_competition",
      "friction_dyn_one-hot",
      "nasa_battery_1_10min",
      "nikuradse_1"
    ],

    "scenarios": [
      "C1",
      "C2"
    ]
  },

  "operator_sets": {
    "C1": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/"
      ],
      "unary_operators": []
    },

    "C2": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/",
        "^"
      ],
      "unary_operators": [
        "exp",
        "log",
        "sqrt"
      ]
    }
  },

  "parameters": {
    "n_layers": 3,
    "num_func_layer": 4,

    "hidden_size": 32,
    "embedding_size": 16,

    "optimizer": "Adam",

    "learning_rate1": 0.0006,
    "learning_rate2": 0.01,

    "controller_epochs": 100,
    "batch_size": 10,

    "n_epochs1": 50,
    "n_epochs2": 50,

    "summary_step": 10,

    "threshold": 0.05,

    "reg_weight": 0.005,

    "risk_seeking": true,
    "risk_factor": 0.5,
    "entropy_weight": 0.005,

    "clip_grad": true,
    "max_norm": 1.0,
    "window_size": 50,

    "refine_constants": true,
    "n_restarts": 1,

    "add_bias": false,

    "use_gpu": false
  },

  "budget_accounting": {
    "unit": "symbolic_candidate",
    "counted_function": "play_episodes",
    "max_evaluations": 1000,
    "batch_size": 10,
    "controller_epochs": 100,
    "early_stopping": true
  },

  "operator_compatibility": {
    "C1": {
      "exact_primitives": [
        "+",
        "-",
        "*"
      ],
      "protected_primitives": [
        "/"
      ],
      "operator_constraints_exact": false,
      "note": "Div utiliza estabilização numérica por epsilon."
    },

    "C2": {
      "protected_primitives": [
        "/",
        "^"
      ],
      "operator_constraints_exact": false,
      "note": "Power utiliza Abs(x)^clip(y,-5,5)."
    }
  },

  "protocol_notes": {
    "total_experiments": 200,
    "datasets": 4,
    "scenarios": 2,
    "seeds": 5,
    "folds": 5,
    "selection_metric": "validation_R2",
    "secondary_metric": "validation_MSE",
    "complexity_metric": "sympy_preorder_node_count",
    "test_set_used_for_search": false,
    "validation_set_used_for_search": false,
    "preserve_individual_results": true
  }
}

