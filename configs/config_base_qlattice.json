{
  "experiment": {
    "budget": {
      "max_evaluations": 1000,
      "max_time_seconds": 3600
    },
    "cross_validation": {
      "n_folds": 5,
      "shuffle": true,
      "seeds": [
        42,
        43,
        44,
        45,
        46
      ]
    },
    "final_seeds": [
      100,
      101,
      102,
      103,
      104,
      105,
      106,
      107,
      108,
      109
    ]
  },
  "operator_sets": {
    "C1": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/"
      ],
      "unary_operators": []
    },
    "C2": {
      "binary_operators": [
        "+",
        "-",
        "*",
        "/",
        "^"
      ],
      "unary_operators": [
        "exp",
        "log",
        "sqrt"
      ]
    }
  },
  "algorithm": "QLattice",
  "parameters": {
    "total_models": 10000,
    "threads": 1,
    "max_edges_per_model": 10,
    "budget_accounting": "number of sampled models; last batch may overshoot slightly"
  },
  "tuning_space": {
    "total_models": 10000,
    "threads": {
      "min": 1,
      "max": "all_available",
      "note": "Fixar no protocolo para comparação justa"
    }
  },
  "protocol_notes": {
    "tuning_repetitions_per_fold": 5,
    "tuning_total_executions_per_dataset_scenario_algorithm": 25,
    "tuning_datasets": [
      "chemical_2_competition_train.csv",
      "friction_dyn_one-hot_train.csv",
      "nasa_battery_1_10min_train.csv",
      "nikuradse_1_train.csv"
    ],
    "selection_metric": "mean_validation_R2",
    "tie_break": "lower_expression_complexity",
    "preserve_all_trials": true,
    "preserve_individual_fold_seed_results": true
  },
  "qlattice_compatibility": {
    "feyn_version": "3.5.0",
    "native_interactions": null,
    "documented_capabilities": [
      "addition",
      "multiplication",
      "square",
      "exponential",
      "logarithm",
      "tanh",
      "square_root",
      "inverse",
      "affine_weights"
    ],
    "operator_sets_exactly_enforced": false,
    "reason": "QLattice/Feyn não oferece restrição pública de primitivas arbitrárias equivalente aos conjuntos C1/C2. Os cenários são mantidos como estratos/metadados do benchmark; não representam restrição exata do espaço de busca.",
    "research_license": "CC BY-NC-ND 4.0; verificar permissões antes de redistribuição ou uso comercial",
    "native_interactions_by_scenario": {
      "C1": [
        "add",
        "multiply",
        "inverse"
      ],
      "C2": [
        "add",
        "multiply",
        "squared",
        "exp",
        "inverse",
        "log",
        "sqrt"
      ]
    },
    "operator_mapping_note": "Subtração pode ser representada por pesos afins com sinal; divisão por inverso e multiplicação. C2 registra quadrado, exponencial, logaritmo e raiz quadrada, mas o conjunto não é imposto como conjunto exato de primitivas."
  }
}
